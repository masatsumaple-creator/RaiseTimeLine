# Claude Code local settings (per-user, not shared)
.claude/settings.local.json

# Secrets / env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build / deps (for when the app is added)
node_modules/
backend/build/
backend/.gradle/
frontend/dist/
*.log

# Performance tests (perf/)
perf/results/*
!perf/results/.gitkeep
perf/browser/test-results/
perf/browser/playwright-report/

# E2E tests (e2e/)
e2e/test-results/
e2e/playwright-report/
e2e/results/*
!e2e/results/.gitkeep

# Terraform (infra/)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
crash.log
*_override.tf
*_override.tf.json
