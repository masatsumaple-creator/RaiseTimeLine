# docker-compose.yml / backend の開発用DB接続情報(.env にコピーして使う。.env はコミットしない)
DB_NAME=raisetimeline
DB_USER=raisetimeline
DB_PASSWORD=raisetimeline
DB_URL=jdbc:postgresql://localhost:5432/raisetimeline

# JWT の署名鍵(32バイト以上)。本番では必ず推測されにくい値を環境変数で渡す。
# ローカルで未設定なら gradle bootRun が開発用の既定値を使う
JWT_SECRET=change-me-to-a-random-string-of-32-bytes-or-more
# アクセストークンの有効期間(例: 30m, 1h)。サーバー側で失効できないため短めにする
JWT_EXPIRATION=30m
