# docker-compose.yml / backend の開発用DB接続情報(.env にコピーして使う。.env はコミットしない)
DB_NAME=raisetimeline
DB_USER=raisetimeline
DB_PASSWORD=raisetimeline
DB_URL=jdbc:postgresql://localhost:5432/raisetimeline

# JWT の署名鍵(32バイト以上)。本番では必ず推測されにくい値を環境変数で渡す。
# ローカルで未設定なら gradle bootRun が開発用の既定値を使う
JWT_SECRET=change-me-to-a-random-string-of-32-bytes-or-more
# アクセストークンの有効期間(例: 15m, 1h)。サーバー側で失効できないため短めにする
JWT_EXPIRATION=15m
# リフレッシュトークン(HttpOnly Cookie)の有効期間
REFRESH_TOKEN_EXPIRATION=7d
# リフレッシュトークン Cookie の Secure 属性。本番(HTTPS)は true、HTTP の開発環境のみ false
REFRESH_COOKIE_SECURE=false
# 使用済みリフレッシュトークンの再提示を、複数タブの同時更新とみなして系統を失効させない猶予
REFRESH_REUSE_GRACE=10s

# 画像(アイコン)を置く S3 バケット。未設定なら画像機能は無効(アップロードは 503、アイコンは頭文字のまま)
S3_BUCKET=
# S3 のリージョン
S3_REGION=ap-northeast-1
# 認証情報のプロファイル(~/.aws)。管理者権限ではなく、このバケットだけを操作できる IAM ユーザーのものを使う
AWS_PROFILE=raisetimeline-dev
