{
  "name": "raisetimeline-e2e",
  "private": true,
  "description": "RaiseTimeLine の E2E テスト(Playwright)。専用 DB(5434)・専用ポート(backend 8081 / frontend 5174)で動き、開発環境と干渉しない",
  "scripts": {
    "install:browser": "playwright install chromium",
    "db:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.e2e.yml down -v",
    "test": "playwright test --project=functional --project=mobile",
    "test:functional": "playwright test --project=functional",
    "test:mobile": "playwright test --project=mobile",
    "test:perf": "cross-env E2E_PERF=1 playwright test --project=perf",
    "test:headed": "playwright test --project=functional --headed",
    "test:ui": "playwright test --project=functional --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "cross-env": "10.1.0",
    "pg": "8.16.3",
    "typescript": "5.9.3"
  }
}
